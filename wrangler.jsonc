{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-barbearia-cliente",
  "previews": {},
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__openpage/region"
    ]
  },
  "main": "worker/regional.ts",
  "vars": {
    "OPENPAGE_TENANT_SLUG": "",
    "OPENPAGE_API_URL": "https://openheimer.vercel.app",
    "OPENPAGE_SITE_ORIGIN": "",
    "OPENPAGE_CATALOG_CURRENCY": "BRL",
    "OPENPAGE_BOOKING_TIMEZONE": "America/Sao_Paulo"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
