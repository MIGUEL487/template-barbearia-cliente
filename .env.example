# Conexão Supabase (Pública / Anon)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# ID da Barbearia vinculada a este site público (UUID da tabela barbershops)
NEXT_PUBLIC_BARBERSHOP_ID=11111111-1111-1111-1111-111111111111

# URL da aplicação pública
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Build-time: alterar exige novo build
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_WATERMARK=true
NEXT_PUBLIC_WATERMARK_TEXT="DEMONSTRAÇÃO · SUA MARCA"
NEXT_PUBLIC_WATERMARK_CONTACT=
