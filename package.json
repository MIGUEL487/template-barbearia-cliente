{
  "name": "template-barbearia-cliente",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:env": "node --env-file=.env.local scripts/check-env.mjs || node scripts/check-env.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "prebuild": "node scripts/prepare-images.mjs && node scripts/snapshot.mjs",
    "preview:cf": "wrangler dev --local --port 8787",
    "deploy:cf": "wrangler deploy",
    "postbuild": "node scripts/headers.mjs",
    "test:qa": "node scripts/qa.mjs",
    "spacing:check": "node scripts/check-spacing.mjs",
    "test:media": "node scripts/qa-media.mjs",
    "prepare:hero": "node scripts/prepare-hero.mjs",
    "prepare:hero:video": "node scripts/encode-hero-video.mjs",
    "prepare:hero:video:pc": "node scripts/encode-hero-video.mjs --desktop-gsap",
    "test:white": "node scripts/qa-white.mjs",
    "test:white:functional": "node scripts/qa-white-functional.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "^0.460.0",
    "motion": "^14.7.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@next/eslint-plugin-next": {
      "glob": "10.5.0"
    }
  },
  "engines": {
    "node": ">=22.6.0"
  }
